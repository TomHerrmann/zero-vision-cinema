{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:email": "email dev --dir emails/previews",
    "email:send": "tsx --tsconfig tsconfig.scripts.json --env-file=.env.local scripts/preview-emails.tsx",
    "email:fixtures": "tsx --tsconfig tsconfig.scripts.json --env-file=.env.local scripts/gen-email-fixtures.tsx",
    "schedule:broadcasts": "PROD_ENV_FALLBACK=QSTASH_TOKEN scripts/with-prod-env.sh tsx --tsconfig tsconfig.scripts.json --env-file=.env.production.local scripts/ensure-broadcast-schedule.tsx",
    "broadcast:send": "PROD_ENV_FALLBACK=QSTASH_TOKEN scripts/with-prod-env.sh tsx --tsconfig tsconfig.scripts.json --env-file=.env.production.local scripts/send-broadcast-now.tsx",
    "orders:repair": "PROD_ENV_FALLBACK=QSTASH_TOKEN scripts/with-prod-env.sh tsx --tsconfig tsconfig.scripts.json --env-file=.env.production.local scripts/repair-stranded-orders.tsx",
    "build": "payload migrate && next build",
    "payload": "payload",
    "test": "vitest run",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@logtail/node": "^0.6.1",
    "@payloadcms/db-vercel-postgres": "^3.93.0",
    "@payloadcms/drizzle": "^3.93.0",
    "@payloadcms/email-resend": "^3.93.0",
    "@payloadcms/graphql": "^3.93.0",
    "@payloadcms/next": "^3.93.0",
    "@payloadcms/payload-cloud": "^3.93.0",
    "@payloadcms/plugin-stripe": "^3.93.0",
    "@payloadcms/richtext-lexical": "^3.93.0",
    "@payloadcms/storage-vercel-blob": "^3.93.0",
    "@payloadcms/ui": "^3.86.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.1",
    "@tailwindcss/typography": "^0.5.16",
    "@upstash/qstash": "^2.12.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "botid": "^1.5.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.11.0",
    "lucide-react": "^0.511.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "payload": "^3.86.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "resend": "^6.37.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-email/ui": "^6.11.8",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "oxlint": "1.92.0",
    "react-email": "^6.11.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.2",
    "typescript": "^7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "sharp": "$sharp"
  }
}
